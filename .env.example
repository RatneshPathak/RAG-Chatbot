# Copy this file to `.env` (which is git-ignored) and fill in values. NEVER commit `.env`.

# --- OpenAI (only for RAG_withOpenai.ipynb / --provider openai) ---
OPENAI_API_KEY=your-key-here
# No default on purpose: pick a chat model that is currently available to your account.
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Ollama (optional overrides; these are the defaults) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=gemma3:1b
